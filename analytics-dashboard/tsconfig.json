{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": ".",
    "types": ["node", "jest"],
    "paths": {
      "~/*": ["./app/*"]
    },
    "noEmit": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "vite.config.ts",
    "react-router.config.ts",
    ".react-router/**/*.ts"
  ],
  "exclude": ["node_modules", "build", "coverage"]
}
