{
  "name": "analytics-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "eslint \"app/**/*.{ts,tsx}\"",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "react-router typegen && tsc --noEmit",
    "install:ui-kit": "cd ../ui-kit && npm run pack && cd ../analytics-dashboard && npm install ../ui-kit/tarballs/ui-kit-styles-*.tgz ../ui-kit/tarballs/ui-kit-utils-*.tgz ../ui-kit/tarballs/ui-kit-react-*.tgz"
  },
  "dependencies": {
    "@ahiggs-ui/react": "^0.2.0",
    "@ahiggs-ui/styles": "^0.2.0",
    "@ahiggs-ui/utils": "^0.2.0",
    "@hookform/resolvers": "^3.9.1",
    "i18next": "^25.8.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "isbot": "^5.1.27",
    "pino": "^10.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^16.5.4",
    "react-router": "^7.13.0",
    "recharts": "^3.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@react-router/dev": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.2",
    "jest-environment-jsdom": "^30.0.2",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^6.0.11"
  }
}
