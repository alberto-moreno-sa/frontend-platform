# Auth Service Environment Variables

# MongoDB connection
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<url>.mongodb.net/?retryWrites=true&w=majority&appName=<cluster_name>

# Redis connection
REDIS_URI=redis://localhost:6379

# Server
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_KID=2024-02-v1
KEY_ENCRYPTION_SECRET=dev-encryption-secret-change-me-in-production
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# JWT Claims
ISSUER_URL=https://auth.yourapp.com
AUDIENCE=yourapp-api

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:6006

# Logging
LOG_LEVEL=DEBUG
