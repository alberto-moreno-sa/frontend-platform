{
  "name": "tracking-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node dist/main.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "helmet": "8.0.0",
    "jose": "5.9.6",
    "kafkajs": "2.2.4",
    "mongoose": "8.9.5",
    "swagger-ui-express": "5.0.1",
    "uuid": "11.0.5",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.7",
    "@types/swagger-ui-express": "4.1.7",
    "@types/uuid": "10.0.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "jest": "29.7.0",
    "prettier": "3.8.1",
    "ts-jest": "29.2.5",
    "tsc-alias": "1.8.16",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.54.0"
  }
}
