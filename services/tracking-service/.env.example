# Tracking Service Environment Variables

# MongoDB connection (separate database from auth-service)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<url>.mongodb.net/?retryWrites=true&w=majority&appName=<cluster_name>

# Server
PORT=3002
NODE_ENV=development

# Broker
BROKER_TYPE=memory

# Kafka (only if BROKER_TYPE=kafka)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=component.tracking
KAFKA_CLIENT_ID=tracking-service
KAFKA_GROUP_ID=tracking-consumer-group

# Auth Service (for JWKS-based JWT verification on export endpoint)
AUTH_SERVICE_URL=http://localhost:3001

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:6006

# Logging
LOG_LEVEL=debug
