{
  "name": "@ahiggs-ui/utils",
  "version": "0.2.0",
  "description": "Utility functions for @ui-kit (cx, sortCx)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/utils.cjs",
  "module": "./dist/utils.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "nx vite:build",
    "dev": "nx vite:build --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vite": "6.0.11",
    "vite-plugin-dts": "4.5.0"
  }
}
